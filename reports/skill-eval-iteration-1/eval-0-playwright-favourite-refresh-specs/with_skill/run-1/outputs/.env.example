# One .env (or CI variable set) per environment/portal. Nothing else about the portal is configured:
# portal ID, view IDs, favourite state, users and dates are discovered at runtime.

# Environment / data centre
ZP_BASE_URL=https://projects.zoho.com
# Portal URL name (the part after /portal/)
ZP_PORTAL=
# Saved login for this portal, created by `npm run auth` (git-ignored). Use one file per portal.
ZP_ADMIN_STATE=auth/admin.json
# Optional: only if this portal labels the predefined view / favourites group differently (e.g. localised UI)
ZP_ALL_USERS_VIEW=
ZP_FAVOURITE_GROUP=
# 1 = tests for known open defects (WL-D-01) become expected failures so CI stays green until fixed
ZP_EXPECT_KNOWN_DEFECTS=0
