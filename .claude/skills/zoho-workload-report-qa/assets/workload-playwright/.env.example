# Environment / data centre
ZP_BASE_URL=https://projects.localzoho.com
# Portal URL name (the part after /portal/)
ZP_PORTAL=usercustomfield
# Saved logins (created by `npm run auth`, never committed)
ZP_ADMIN_STATE=auth/admin.json
# One saved login per permission profile under test (JSON map: profile key -> storage state file)
# Keys: none, view, manage, delete, full, projonly, globonly  (omit the ones you do not have)
ZP_USER_STATES={"cp":"auth/wl.cp.json","view":"auth/wl.view.json","manage":"auth/wl.manage.json","delete":"auth/wl.delete.json","full":"auth/wl.full.json","none":"auth/wl.none.json"}
# Which logins `npm run auth` should capture this time (comma separated keys; "admin" for the Admin)
ZP_AUTH_TARGETS=admin
# Prefix for everything a run creates; defaults to QA-WL-<timestamp>
RUN_ID=
# Set to 1 to mark tests for known open defects as expected failures (test.fail) instead of red
ZP_EXPECT_KNOWN_DEFECTS=0
# Week start used by the portal: 0 = Sunday (reference portal), 1 = Monday
ZP_WEEK_START=0
# Date order the UI shows (follows the user's date format): dmy | mdy; empty = detect from the report header
ZP_DATE_ORDER=
# Name prefix of the Admin-shared seed custom view used by permission tests
ZP_SEED_VIEW_PREFIX=QA-WL-SEED
# --- permission levels spec (one profile, switched by API) ---
# Profile under test, as named in Setup > Profiles, and a saved login of a user with that profile
ZP_PERM_PROFILE=CP
ZP_PERM_USER_STATE=auth/wl.cp.json
# Optional project for project-level checks (default: first project the user can open)
ZP_PERM_PROJECT_ID=
# Required for any permission change (Setup checkboxes or API); restored at the end of the run
ZP_ALLOW_PROFILE_CHANGES=0
# --- edit scope (SCOPE-01): second user; expected scope once product decides: portal | user ---
ZP_SCOPE_USER_STATE=
ZP_EDIT_SCOPE=
# --- real-data spec: 1 = run (creates a project, imports, compares, trashes it); 1 = keep the project ---
ZP_RUN_DATA_SPEC=0
ZP_KEEP_DATA_PROJECT=0
# Database settings
DB_URL=jdbc:mysql://127.0.0.1:3306/webautomation
DB_USER=root
DB_PASSWORD=